# X-ray images stay local. Public datasets are gigabytes, and even
# de-identified medical images do not belong in a repo by reflex.
data/*/*/
!data/**/.gitkeep

# The same, for the sibling split directories. src.mask_lungs writes
# data-masked/, and anything comparing two preparations writes another one
# beside it -- none of which data/*/*/ above covers.
data-*/

# The downloaded archives themselves. The Kaggle radiography set is 816 MB and
# lands wherever it was unzipped from; git add -A should not be able to reach
# for it.
*.zip
*.tar
*.tar.gz

checkpoints/
reports/
*.pt
*.pth
cam*.png

__pycache__/
*.pyc
.ipynb_checkpoints/

# Compiles this machine's venv path in, so it does not travel.
.claude/launch.json
